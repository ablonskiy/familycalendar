# OPENROUTER_API_KEY: Required for AI processing via OpenRouter.
OPENROUTER_API_KEY="your_openrouter_api_key"

# Telegram Bot Token
TELEGRAM_BOT_TOKEN="your_bot_token"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# App URL (automatically set in runtime, but for local dev)
APP_URL="MY_APP_URL"

# Allowed Telegram User IDs (comma separated)
ALLOWED_USER_IDS="12345678,87654321"

# Timezone for calendar events (e.g. Europe/Moscow)
TIMEZONE="Europe/Moscow"

# Password for the settings dashboard
ADMIN_PASSWORD="your_secure_password"

# Base path for subfolder deployment (e.g. /familybot/)
VITE_BASE_PATH="/"
